{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-test",
  "description": "Local Tether window for the Windows personal test build.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-snapshot",
    "allow-get-autostart-state",
    "allow-set-autostart",
    "allow-start-network",
    "allow-refresh-networks",
    "allow-stop-control",
    "allow-new-code",
    "allow-decide-phone",
    "allow-revoke-phones"
  ]
}
