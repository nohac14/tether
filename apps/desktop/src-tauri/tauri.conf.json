{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.1.0",
  "identifier": "app.tether.personal",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Tether · Windows test",
        "width": 610,
        "height": 690,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["windows-test"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
