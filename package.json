{
  "name": "tether",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "check:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "check:eslint": "eslint .",
    "check:format": "cargo fmt --all --check",
    "check:generated": "node tooling/generate-protocol.mjs --check",
    "check:links": "node tooling/check-links.mjs",
    "check:markdown": "markdownlint --config .markdownlint.json --ignore-path .gitignore \"**/*.md\"",
    "check:prettier": "prettier --check .",
    "check:protocol": "node tooling/check-protocol.mjs",
    "check:secrets": "node tooling/check-secrets.mjs",
    "check:types": "pnpm --recursive run typecheck",
    "test:unit": "vitest run && pnpm test:secrets",
    "test:secrets": "node --test tooling/check-secrets.test.mjs"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.1.6",
    "vitest": "5.0.3"
  }
}
